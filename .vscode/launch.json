{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug identity-service with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "identity-service"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/identity-service/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to bff-service",
      "port": 9231,
      "restart": false,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "outFiles": ["${workspaceFolder}/dist/apps/bff-service/**/*.js", "!**/node_modules/**"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to identity-service",
      "port": 9229,
      "restart": false,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "${workspaceFolder}",
      "outFiles": ["${workspaceFolder}/dist/apps/identity-service/**/*.js", "!**/node_modules/**"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
