{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-gateway/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/src/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/api-gateway"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api-gateway"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api-gateway/package.json",
        "{workspaceRoot}/dist/apps/api-gateway/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api-gateway/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "parallel": true,
        "commands": [
          "webpack-cli build --node-env=production --watch",
          "node --watch ../../dist/apps/api-gateway/main.js"
        ],
        "cwd": "apps/api-gateway"
      },
      "configurations": {
        "development": {
          "commands": [
            "webpack-cli build --node-env=development --watch",
            "node --watch ../../dist/apps/api-gateway/main.js"
          ]
        },
        "production": {
          "commands": ["webpack-cli build --node-env=production", "node ../../dist/apps/api-gateway/main.js"]
        },
        "debug": {
          "commands": [
            "webpack-cli build --node-env=development",
            "node --inspect-brk=9231 ../../dist/apps/api-gateway/main.js"
          ]
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
